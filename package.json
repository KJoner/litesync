{
  "name": "litesync",
  "version": "0.17.0-rc.4",
  "description": "Sync your vault with your own self-hosted LiteSync server.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/run-tests.mjs",
    "test:mobile": "node scripts/check-mobile.mjs && npm run build && npm test",
    "lint": "eslint .",
    "check:adr": "node scripts/check-adr.mjs",
    "check:inv": "node scripts/check-inv.mjs"
  },
  "keywords": [
    "obsidian",
    "sync"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
