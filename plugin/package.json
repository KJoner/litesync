{
  "name": "obsidian-private-sync",
  "version": "0.1.0",
  "description": "Sync this vault with your own private obsync server.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "esbuild tests/unit.test.ts --bundle --platform=node --format=cjs --outfile=.test-build/unit.test.cjs && node --test .test-build/unit.test.cjs"
  },
  "keywords": ["obsidian", "sync"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0"
  }
}
